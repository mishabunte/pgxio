# Experimental only. The normal Dockerfile keeps the system libpq and copy path.
FROM rust:slim-trixie@sha256:4df2ae8cfdfebdfc13a65da7f253b73d68983dc0339f2719bc17a279c913b13d AS libpq
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl ca-certificates bison flex libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
ARG POSTGRES_REF=e7cfc38544bd66dbf4c4417328bb4f263184e887
RUN curl -fsSL https://codeload.github.com/mishabunte/postgres/tar.gz/${POSTGRES_REF} | tar xz -C /tmp && mv /tmp/postgres-${POSTGRES_REF} /postgres
WORKDIR /postgres
ARG LIBPQ_SANITIZERS=""
RUN if [ -n "$LIBPQ_SANITIZERS" ]; then export CFLAGS="-O1 -g -fsanitize=$LIBPQ_SANITIZERS -fno-omit-frame-pointer" LDFLAGS="-fsanitize=$LIBPQ_SANITIZERS"; fi; ./configure --prefix=/opt/pgxio-libpq --with-ssl=openssl --without-icu --without-readline --without-zlib --without-gssapi --without-ldap --without-libcurl --without-lz4 --without-zstd && make -C src/backend generated-headers && make -j2 -C src/interfaces/libpq && make -C src/interfaces/libpq install && make -C src/interfaces/libpq/test

RUN make -C src/include install

FROM rust:slim-trixie@sha256:4df2ae8cfdfebdfc13a65da7f253b73d68983dc0339f2719bc17a279c913b13d AS build
ARG NGINX_VERSION=1.30.5
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl ca-certificates git libclang-dev libpcre2-dev libssl-dev zlib1g-dev libpq-dev pkg-config && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz | tar xz -C /tmp && mv /tmp/nginx-${NGINX_VERSION} /nginx
WORKDIR /nginx
RUN ./configure --prefix=/usr/local/nginx --with-compat --with-http_ssl_module --with-http_v2_module --with-http_stub_status_module --error-log-path=stderr --http-log-path=/dev/stdout --pid-path=/tmp/nginx.pid --http-client-body-temp-path=/tmp/client_body --http-proxy-temp-path=/tmp/proxy && make -j2
ENV NGINX_SOURCE_DIR=/nginx NGINX_BUILD_DIR=/nginx/objs
COPY --from=libpq /opt/pgxio-libpq /opt/pgxio-libpq
ENV PQ_LIB_DIR=/opt/pgxio-libpq/lib LD_LIBRARY_PATH=/opt/pgxio-libpq/lib
ENV RUSTFLAGS="-C link-arg=-Wl,-rpath,/opt/pgxio-libpq/lib"
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY examples ./examples
ARG CARGO_FEATURES=borrowed-libpq
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/usr/local/cargo/git --mount=type=cache,target=/build/target cargo test --release --locked --test core --test allocations --features "$CARGO_FEATURES" -- --nocapture && cargo build --release --locked --features "$CARGO_FEATURES" && cp target/release/libngx_http_pgxio_module.so /module.so

FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG CARGO_FEATURES=borrowed-libpq
ARG POSTGRES_REF=e7cfc38544bd66dbf4c4417328bb4f263184e887
ARG LIBPQ_BORROWED=1
LABEL io.pgxio.config-format="nginx-v1" io.pgxio.output-validation="off"
LABEL io.pgxio.rest-input-validation="postgres" io.pgxio.borrowed-libpq="$LIBPQ_BORROWED" io.pgxio.cargo-features="$CARGO_FEATURES" io.pgxio.libpq-base="$POSTGRES_REF"
RUN apt-get update && apt-get install -y --no-install-recommends libssl3t64 libpcre2-8-0 zlib1g ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --no-create-home pgxio && mkdir -p /tmp/client_body /tmp/proxy /usr/local/nginx/logs && chown -R pgxio /tmp/client_body /tmp/proxy /usr/local/nginx
COPY --from=libpq /opt/pgxio-libpq /opt/pgxio-libpq
ENV LD_LIBRARY_PATH=/opt/pgxio-libpq/lib
COPY --from=build /nginx/objs/nginx /usr/local/bin/nginx
COPY --from=build /module.so /usr/local/nginx/modules/libngx_http_pgxio_module.so
COPY deploy/nginx.conf /etc/nginx/nginx.conf
USER 10001
EXPOSE 8080
STOPSIGNAL SIGQUIT
ENTRYPOINT ["nginx"]
CMD ["-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
