+int
+pqSealBorrowedOutput(PGconn *conn)
+{
+	PGBorrowedOutput *part;
+	char	   *data;
+
+	if (conn->outCount == 0)
+		return 0;
+	if (conn->borrowBytes > UINT64_MAX - conn->outCount)
+	{
+		libpq_append_conn_error(conn, "queued output is too large");
+		return -1;
