diff --git a/src/interfaces/libpq/fe-exec.c b/src/interfaces/libpq/fe-exec.c
index 294690648b..a9c3cc502a 100644
--- a/src/interfaces/libpq/fe-exec.c
+++ b/src/interfaces/libpq/fe-exec.c
@@ -28,6 +28,7 @@
 #include "libpq-fe.h"
 #include "libpq-int.h"
 #include "mb/pg_wchar.h"
+#include "port/pg_bswap.h"
 
 /* keep this in same order as ExecStatusType in libpq-fe.h */
 char	   *const pgresStatus[] = {
@@ -4780,3 +4781,300 @@ PQunescapeBytea(const unsigned char *strtext, size_t *retbuflen)
 	*retbuflen = buflen;
 	return tmpbuf;
 }
+
+/* Append a network-order integer to an owned protocol fragment. */
+static void
+borrowInt(PQExpBuffer b, uint32 value, int width)
+{
+	if (width == 2)
+	{
+		uint16		v = pg_hton16((uint16) value);
+
+		appendBinaryPQExpBuffer(b, (char *) &v, 2);
+	}
+	else
+	{
+		uint32		v = pg_hton32(value);
+
+		appendBinaryPQExpBuffer(b, (char *) &v, 4);
+	}
+}
+
+static bool
+borrowPart(PGBorrowedOutput **head, PGBorrowedOutput **tail,
+		   const char *data, size_t len, bool owned)
+{
+	PGBorrowedOutput *part;
+
+	if (!len)
+		return true;
+	part = calloc(1, sizeof(*part));
+	if (!part)
+		return false;
+	part->data = data;
+	part->len = len;
+	part->owned = owned;
+	if (*tail)
+		(*tail)->next = part;
+	else
+		*head = part;
+	*tail = part;
+	return true;
+}
+
+static bool
+borrowSeal(PQExpBuffer b, PGBorrowedOutput **head, PGBorrowedOutput **tail)
+{
+	if (PQExpBufferBroken(b) || b->len > INT_MAX)
+		return false;
+	if (!b->len)
+		return true;
+	if (!borrowPart(head, tail, b->data, b->len, true))
+		return false;
+	initPQExpBuffer(b);			/* Ownership of the old allocation passed to
+								 * the list. */
+	return !PQExpBufferBroken(b);
+}
+
+/*
+ * Build off-connection so allocation/validation failures cannot publish a
+ * partial message.  Old entry points continue to copy all parameter data.
+ */
+static int
+sendBorrowed(PGconn *conn, const char *command, const char *name,
+			 int nParams, const Oid *types, const PQborrowedParam *params,
+			 int resultFormat)
+{
+	PGBorrowedOutput *head = NULL,
+			   *tail = NULL;
+	PGcmdQueueEntry *entry = NULL;
+	PQExpBufferData b;
+	size_t		bindlen,
+				namelen,
+				commandlen = command ? strlen(command) : 0;
+	int		   *lengths = NULL;
+	uint64		newBytes = 0;
+	int			i;
+
+	if (!PQsendQueryStart(conn, true))
+		return 0;
+	if (!name || nParams < 0 || nParams > PQ_QUERY_PARAM_MAX_LIMIT ||
+		(nParams && !params) || (resultFormat != 0 && resultFormat != 1))
+	{
+		libpq_append_conn_error(conn, "invalid borrowed query arguments");
+		return 0;
+	}
+	namelen = strlen(name);
+	if (namelen > INT_MAX / 2 || commandlen > INT_MAX / 2 ||
+		namelen + commandlen + 8 + 4 * (size_t) nParams > INT_MAX)
+	{
+		libpq_append_conn_error(conn, "borrowed query message is too large");
+		return 0;
+	}
+	lengths = calloc(Max(nParams, 1), sizeof(int));
+	if (!lengths)
+	{
+		libpq_append_conn_error(conn, "out of memory");
+		return 0;
+	}
+	bindlen = 14 + namelen + 6 * (size_t) nParams;
+	for (i = 0; i < nParams; i++)
+	{
+		size_t		j,
+					len = 0;
+		const PQborrowedParam *p = &params[i];
+
+		if ((p->format != 0 && p->format != 1) ||
+			(p->isnull != 0 && p->isnull != 1) ||
+			p->nsegments > SIZE_MAX / sizeof(PQbuffer) ||
+			(!p->isnull && p->nsegments && !p->segments))
+			goto invalid;
+		if (p->isnull)
+			continue;
+		for (j = 0; j < p->nsegments; j++)
+		{
+			const PQbuffer *s = &p->segments[j];
+
+			if (s->len > INT_MAX - len || (s->len && !s->data))
+				goto invalid;
+			if (p->format == 0 && s->len && memchr(s->data, 0, s->len))
+				goto invalid;
+			len += s->len;
+		}
+		if (len > INT_MAX - bindlen)
+			goto invalid;
+		bindlen += len;
+		lengths[i] = (int) len;
+	}
+
+	/* Tracing expects a contiguous message: explicitly use the copied API. */
+	if (conn->Pfdebug)
+	{
+		char	  **values = calloc(Max(nParams, 1), sizeof(char *));
+		int		   *formats = calloc(Max(nParams, 1), sizeof(int));
+		int			ok = 0;
+
+		if (values && formats)
+		{
+			for (i = 0; i < nParams; i++)
+			{
+				size_t		j,
+							offset = 0;
+
+				formats[i] = params[i].format;
+				if (params[i].isnull)
+					continue;
+				values[i] = malloc((size_t) lengths[i] + 1);
+				if (!values[i])
+					break;
+				for (j = 0; j < params[i].nsegments; j++)
+				{
+					const PQbuffer *s = &params[i].segments[j];
+
+					if (s->len)
+						memcpy(values[i] + offset, s->data, s->len);
+					offset += s->len;
+				}
+				values[i][offset] = 0;
+			}
+			if (i == nParams)
+			{
+				ok = PQsendQueryGuts(conn, command, name, nParams, types,
+									 (const char *const *) values, lengths, formats, resultFormat);
+				if (!ok)
+				{
+					pqDropConnection(conn, false);
+					conn->status = CONNECTION_BAD;
+				}
+			}
+			else
+				libpq_append_conn_error(conn, "out of memory");
+		}
+		else
+			libpq_append_conn_error(conn, "out of memory");
+		if (values)
+			for (i = 0; i < nParams; i++)
+				free(values[i]);
+		free(values);
+		free(formats);
+		free(lengths);
+		return ok;
+	}
+
+	initPQExpBuffer(&b);
+	entry = pqAllocCmdQueueEntry(conn);
+	if (!entry)
+		goto failed;
+	if (command)
+	{
+		appendPQExpBufferChar(&b, PqMsg_Parse);
+		borrowInt(&b, 8 + namelen + commandlen + (types ? 4 * nParams : 0), 4);
+		appendBinaryPQExpBuffer(&b, name, namelen + 1);
+		appendBinaryPQExpBuffer(&b, command, commandlen + 1);
+		borrowInt(&b, types ? nParams : 0, 2);
+		if (types)
+			for (i = 0; i < nParams; i++)
+				borrowInt(&b, types[i], 4);
+	}
+	appendPQExpBufferChar(&b, PqMsg_Bind);
+	borrowInt(&b, bindlen, 4);
+	appendPQExpBufferChar(&b, 0);	/* unnamed portal */
+	appendBinaryPQExpBuffer(&b, name, namelen + 1);
+	borrowInt(&b, nParams, 2);
+	for (i = 0; i < nParams; i++)
+		borrowInt(&b, params[i].format, 2);
+	borrowInt(&b, nParams, 2);
+	for (i = 0; i < nParams; i++)
+	{
+		size_t		j;
+
+		borrowInt(&b, params[i].isnull ? (uint32) -1 : lengths[i], 4);
+		if (params[i].isnull || !lengths[i])
+			continue;
+		if (!borrowSeal(&b, &head, &tail))
+			goto failed;
+		for (j = 0; j < params[i].nsegments; j++)
+			if (!borrowPart(&head, &tail, params[i].segments[j].data,
+							params[i].segments[j].len, false))
+				goto failed;
+	}
+	borrowInt(&b, 1, 2);
+	borrowInt(&b, resultFormat, 2);
+	appendPQExpBufferChar(&b, PqMsg_Describe);
+	borrowInt(&b, 6, 4);
+	appendPQExpBufferChar(&b, 'P');
+	appendPQExpBufferChar(&b, 0);
+	appendPQExpBufferChar(&b, PqMsg_Execute);
+	borrowInt(&b, 9, 4);
+	appendPQExpBufferChar(&b, 0);
+	borrowInt(&b, 0, 4);
+	if (conn->pipelineStatus == PQ_PIPELINE_OFF)
+	{
+		appendPQExpBufferChar(&b, PqMsg_Sync);
+		borrowInt(&b, 4, 4);
+	}
+	if (!borrowSeal(&b, &head, &tail))
+		goto failed;
+	for (PGBorrowedOutput *part = head; part; part = part->next)
+		newBytes += part->len;
+	if (conn->borrowBytes > UINT64_MAX - newBytes - conn->outCount)
+		goto failed;
+	/* Allocation failure here leaves the old output and new query untouched. */
+	if (pqSealBorrowedOutput(conn) < 0)
+		goto failed;
+	if (conn->borrowTail)
+		conn->borrowTail->next = head;
+	else
+		conn->borrowHead = head;
+	conn->borrowTail = tail;
+	conn->borrowBytes += newBytes;
+	head = NULL;
+	entry->queryclass = PGQUERY_EXTENDED;
+	if (command)
+		entry->query = strdup(command);
+	termPQExpBuffer(&b);
+	free(lengths);
+	/* Sending failure releases all borrowed references by closing transport. */
+	if ((conn->pipelineStatus == PQ_PIPELINE_OFF || conn->borrowBytes >= 8192) && pqFlush(conn) < 0)
+	{
+		pqDropConnection(conn, false);
+		conn->status = CONNECTION_BAD;
+		pqRecycleCmdQueueEntry(conn, entry);
+		return 0;
+	}
+	pqAppendCmdQueueEntry(conn, entry);
+	return 1;
+
+invalid:
+	libpq_append_conn_error(conn, "invalid borrowed parameter or message length");
+	free(lengths);
+	return 0;
+failed:
+	libpq_append_conn_error(conn, "could not allocate borrowed query message");
+	pqFreeBorrowedOutput(head);
+	termPQExpBuffer(&b);
+	pqRecycleCmdQueueEntry(conn, entry);
+	free(lengths);
+	return 0;
+}
+
+int
+PQsendQueryParamsBorrowed(PGconn *conn, const char *command, int nParams,
+						  const Oid *paramTypes, const PQborrowedParam *params,
+						  int resultFormat)
+{
+	if (!command)
+	{
+		if (conn)
+			libpq_append_conn_error(conn, "command string is a null pointer");
+		return 0;
+	}
+	return sendBorrowed(conn, command, "", nParams, paramTypes, params, resultFormat);
+}
+
+int
+PQsendQueryPreparedBorrowed(PGconn *conn, const char *name, int nParams,
+							const PQborrowedParam *params, int resultFormat)
+{
+	return sendBorrowed(conn, NULL, name, nParams, NULL, params, resultFormat);
+}
