diff --git a/src/interfaces/libpq/t/007_borrowed.pl b/src/interfaces/libpq/t/007_borrowed.pl
new file mode 100644
index 0000000000..a1dc1fd53f
--- /dev/null
+++ b/src/interfaces/libpq/t/007_borrowed.pl
@@ -0,0 +1,21 @@
+# Copyright (c) 2026, PostgreSQL Global Development Group
+use strict;
+use warnings FATAL => 'all';
+use PostgreSQL::Test::Utils;
+use PostgreSQL::Test::Cluster;
+use Test::More;
+
+plan skip_all => 'borrowed buffer guard-page test requires POSIX' if $^O eq 'MSWin32';
+my $node = PostgreSQL::Test::Cluster->new('borrowed');
+$node->init;
+$node->start;
+command_ok(['libpq_borrowed', $node->connstr('postgres')],
+    'borrowed buffers, mixed pipelines and release under backpressure');
+SKIP: {
+    my ($directory) = grep { -f "$_/borrowed_faults.so" } split(/:/, $ENV{PATH});
+    skip 'Linux fault shim unavailable', 1 unless $^O eq 'linux' && $directory;
+    command_ok(['env', "LD_PRELOAD=$directory/borrowed_faults.so",
+        'LIBPQ_TEST_SHORT_WRITES=1', 'libpq_borrowed', $node->connstr('postgres')],
+        'allocation failures, interrupted and short writes');
+}
+done_testing();
